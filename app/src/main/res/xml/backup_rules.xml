<?xml version="1.0" encoding="utf-8"?><!--
   バックアップの対象 (Android 11 以前の端末用。12 以降は data_extraction_rules.xml)。
   See https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <!-- セッション (アクセストークン)。Keystore の鍵で暗号化しており、鍵は端末の外に出ないので復元しても読めない -->
    <exclude domain="sharedpref" path="secure.xml" />
    <!-- 以前の平文の保存 (起動時に secure.xml へ移して消す) -->
    <exclude domain="sharedpref" path="session.xml" />
</full-backup-content>

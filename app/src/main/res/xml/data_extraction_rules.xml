<?xml version="1.0" encoding="utf-8"?><!--
   バックアップ・端末間の移行の対象 (Android 12 以降)。
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <!-- セッション (アクセストークン) は Keystore の鍵で暗号化しており、鍵は端末の外に出ないので移しても読めない。
         session.xml は以前の平文の保存 (起動時に secure.xml へ移して消す) -->
    <cloud-backup>
        <exclude domain="sharedpref" path="secure.xml" />
        <exclude domain="sharedpref" path="session.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="secure.xml" />
        <exclude domain="sharedpref" path="session.xml" />
    </device-transfer>
</data-extraction-rules>

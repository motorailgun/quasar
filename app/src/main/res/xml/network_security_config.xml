<?xml version="1.0" encoding="utf-8"?>
<!-- debuggable なビルド (debug) だけ、ユーザーが入れた CA も信頼する。testbed の自前の CA のため。 -->
<network-security-config>
    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>

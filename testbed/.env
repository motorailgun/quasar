# Quasar の動作確認用の連合環境 (testbed/README.md)。ここを書き換えて ./testbed.sh up で入れ替わる。

# latest alpha: Mastodon は alpha を版で tag しないので main の nightly (4.8.0-alpha.x) を日付で固定する
ALPHA_TAG=nightly.2026-10-19
# latest stable
STABLE_TAG=v4.7.3
LEGACY_TAG=v3.5.19

# ホストに公開する HTTPS の口 (端末から繋ぐ時用)。外に出したくなければ 127.0.0.1 のまま
TESTBED_BIND=127.0.0.1
TESTBED_HTTPS_PORT=443

# 端末から見たホストのアドレス。DNS (dns サービス) が *.quasar.test をここに向ける。エミュレーターは 10.0.2.2
DEVICE_HOST_ADDR=10.0.2.2

# bots の動作間隔 (秒)
BOT_INTERVAL=12
